/*
 */

#include <dt-bindings/gpio/gpio.h>

&camss {
	status = "okay";

	vdda-csiphy-1p2-supply = <&pm4125_l5>;
	vdda-pll-1p8-supply = <&pm4125_l13>;
};

&cci {
	status= "okay";
};

&cci_i2c0 {
	clock-frequency = <100000>;
	#address-cells = <1>;
	#size-cells = <0>;

	pca9555: gpio@26 {
		compatible = "nxp,pca9555";
		reg = <0x26>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	imu@6a {
		compatible = "st,lsm6dsox";
		reg = <0x6a>;
	};
};

&cci_i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;

	imu@6a {
		compatible = "st,lsm6dsox";
		reg = <0x6a>;
	};
};